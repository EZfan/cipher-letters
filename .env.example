# The Cipher Letters — environment configuration
# Copy this file to .env and edit as needed. The server reads variables
# via `process.env` at startup; no `.env` file is auto-loaded.

# --- HTTP server ---
PORT=4317
HOST=127.0.0.1

# --- LLM backend ---
# Any OpenAI-compatible endpoint. Ollama, llama.cpp server, LM Studio,
# vLLM, OpenAI, DeepSeek, etc.
LLM_BASE_URL=http://127.0.0.1:11434/v1

# Ollama ignores this. OpenAI / DeepSeek require a real key.
LLM_API_KEY=ollama

# Model name as understood by the backend.
# Recommended for local Chinese + English: qwen2.5:7b (Q4_K_M, ~5GB)
# Recommended for English: llama3.1:8b-instruct-q4_K_M
# Recommended for top-tier Chinese via cloud: deepseek-chat
LLM_MODEL=qwen2.5:7b

# --- Logging ---
LOG_LEVEL=info
# NODE_ENV=production
